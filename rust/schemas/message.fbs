namespace language_host;

// Wire protocol for Coderm Language Host communication.
// Shared between Rust (host) and TypeScript (renderer/main bridge) via flatc codegen.

enum MessageType:ubyte {
    Request = 0,
    Response = 1,
    Notification = 2
}

table Request {
    id: uint64;
    method: string;
    params: [ubyte];
}

table Response {
    id: uint64;
    result: [ubyte];
    error: string;
}

table Notification {
    method: string;
    params: [ubyte];
}

union MessageBody {
    Request: Request,
    Response: Response,
    Notification: Notification
}

table Message {
    type: MessageType;
    body: MessageBody;
}

root_type Message;
